# ══════════════════════════════════════════════════════════════════
# Dockerfile.backend — Multi-stage Python build
# Stage 1: builder  — installs dependencies
# Stage 2: runtime  — lean production image
# ══════════════════════════════════════════════════════════════════

# ── Stage 1: Builder ──────────────────────────────────────────────
FROM python:3.12-slim AS builder

WORKDIR /build

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc g++ libpq-dev curl \
    && rm -rf /var/lib/apt/lists/*

# Copy and install Python dependencies
# Do this before copying source code so Docker layer cache is reused
# when only source code changes (not requirements)
COPY requirements.txt .
RUN pip install --upgrade pip \
    && pip install --no-cache-dir --prefix=/install -r requirements.txt


# ── Stage 2: Runtime ──────────────────────────────────────────────
FROM python:3.12-slim AS runtime

WORKDIR /app

# Runtime system dependencies only
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 curl \
    && rm -rf /var/lib/apt/lists/*

# Copy installed packages from builder
COPY --from=builder /install /usr/local

# Create non-root user for security
RUN useradd -m -u 1000 appuser && chown -R appuser:appuser /app
USER appuser

# Copy application source
COPY --chown=appuser:appuser backend/     ./backend/
COPY --chown=appuser:appuser services/    ./services/
COPY --chown=appuser:appuser utils/       ./utils/
COPY --chown=appuser:appuser .env.example ./.env.example

# Create outputs directory (Phase 1 compatibility)
RUN mkdir -p outputs/logs outputs/predictions

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

EXPOSE 8000

CMD ["uvicorn", "backend.main:app", \
     "--host", "0.0.0.0", \
     "--port", "8000", \
     "--workers", "2", \
     "--log-level", "info"]