# ══════════════════════════════════════════════════════════════════
# Forecasting Platform — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ══════════════════════════════════════════════════════════════════

# ── App ───────────────────────────────────────────────────────────
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# ── Security ──────────────────────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-min-32-chars-change-this
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Database (PostgreSQL) ─────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/forecasting_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ── Testing (used only by conftest.py / pytest) ────────────────────
# Points at a separate, disposable Postgres database — schema is
# created/dropped every test session via Base.metadata.create_all()/
# drop_all(). Never point this at the same database as DATABASE_URL above.
TEST_DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/dmc_test

# ── Redis ─────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── AWS ───────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET_NAME=forecasting-platform-data
S3_UPLOAD_PREFIX=uploads/
S3_OUTPUT_PREFIX=outputs/

# ── LLM (HuggingFace) ────────────────────────────────────────────
HF_TOKEN=your-huggingface-token
LLM_MODEL_ID=Qwen/Qwen2.5-7B-Instruct

# ── CORS ──────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Forecasting Defaults ──────────────────────────────────────────
DEFAULT_FORECAST_HORIZON=60
DEFAULT_TEST_WINDOW=30
MAX_UPLOAD_SIZE_MB=50
