# ── Python ────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg
*.egg-info/
dist/
build/
.eggs/

# ── Virtual environments ───────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Runtime artifacts (TD-002 fix) ────────────────────────────────
# These were committed in v1.0 — now excluded
outputs/
debug_outputs/
*.flag
*.lock
*.log

# ── Environment variables ─────────────────────────────────────────
.env
.env.*
# keep the example template committed — git doesn't support inline
# comments on a pattern line, so this must be a separate line above it
!.env.example

# ── IDE ───────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# ── Jupyter ───────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── Testing ───────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/

# ── Frontend ──────────────────────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/.env
frontend/.env.*
!frontend/.env.example

# ── Docker ────────────────────────────────────────────────────────
docker/secrets/

# ── AWS / Terraform ───────────────────────────────────────────────
infra/.terraform/
infra/*.tfstate
infra/*.tfstate.backup
infra/.terraform.lock.hcl
infra/terraform.tfvars      # contains secrets

